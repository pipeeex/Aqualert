<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="56dp"
    android:paddingBottom="@dimen/space_xs">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_logo_circulo"
        android:contentDescription="@string/chat_titulo"
        android:padding="4dp"
        android:src="@drawable/ic_logo_aqualert" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtMensaje"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_burbuja_bot"
            android:lineSpacingMultiplier="1.3"
            android:padding="@dimen/space_m"
            android:textColor="@color/neutral_grey130"
            android:textSize="@dimen/text_body"
            tools:text="Para crear un reporte entra a la seccion Reportes y pulsa el boton Reportar." />

        <TextView
            android:id="@+id/txtHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Aqualert.Caption"
            tools:text="14:32" />
    </LinearLayout>

</LinearLayout>