<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Aqualert.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_volver"
            app:navigationIcon="@drawable/ic_atras"
            app:title="@string/con_titulo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_m"
            android:text="@string/con_subtitulo"
            android:textAppearance="@style/TextAppearance.Aqualert.Body" />

        <!-- Filtro por categoria -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_s"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_stroke" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaConsejos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_xl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_consejo" />

    <TextView
        android:id="@+id/txtVacio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:drawablePadding="@dimen/space_m"
        android:gravity="center"
        android:text="@string/con_sin_consejos"
        android:textAppearance="@style/TextAppearance.Aqualert.Body"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_consejos"
        tools:visibility="visible" />

    <ProgressBar
        android:id="@+id/progreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>