<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Aqualert.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/cd_volver"
            app:navigationIcon="@drawable/ic_atras"
            app:title="@string/rep_crear_titulo" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_l"
            android:paddingTop="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:id="@+id/txtEstadoActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_m"
                android:background="@drawable/bg_chip_suave"
                android:paddingStart="@dimen/space_s"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_s"
                android:paddingBottom="@dimen/space_xs"
                android:textColor="@color/fluent_accent_dark"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="Estado actual: Publicado"
                tools:visibility="visible" />

            <!-- =============== IMAGEVIEW: evidencia =============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rep_foto_evidencia"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/rep_evidencia_ayuda"
                android:textAppearance="@style/TextAppearance.Aqualert.Caption" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgEvidencia"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:clickable="true"
                    android:contentDescription="@string/cd_foto_reporte"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/foto_demo_1" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCambiarFoto"
                    style="@style/Widget.Aqualert.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/rep_cambiar_evidencia"
                    app:icon="@drawable/ic_camara" />

                <TextView
                    android:id="@+id/txtContadorFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:textAppearance="@style/TextAppearance.Aqualert.Caption"
                    tools:text="1 / 6" />
            </LinearLayout>

            <!-- =============== Datos del reporte =============== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTitulo"
                style="@style/Widget.Aqualert.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:hint="@string/rep_campo_titulo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDescripcion"
                style="@style/Widget.Aqualert.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:hint="@string/rep_campo_descripcion"
                app:counterEnabled="true"
                app:counterMaxLength="1000">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- =============== LISTA DESPLEGABLE =============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/rep_tipo_contaminacion"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardElevation="0dp">

                <Spinner
                    android:id="@+id/spinnerTipo"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_input"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m" />
            </com.google.android.material.card.MaterialCardView>

            <!-- =============== BOTONES DE RADIO =============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/rep_nivel_riesgo"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rep_nivel_riesgo_ayuda"
                android:textAppearance="@style/TextAppearance.Aqualert.Caption" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardElevation="0dp">

                <RadioGroup
                    android:id="@+id/grupoRiesgo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_s">

                    <RadioButton
                        android:id="@+id/radioRiesgoBajo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/riesgo_bajo" />

                    <RadioButton
                        android:id="@+id/radioRiesgoMedio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/riesgo_medio" />

                    <RadioButton
                        android:id="@+id/radioRiesgoAlto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/riesgo_alto" />

                    <RadioButton
                        android:id="@+id/radioRiesgoCritico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/riesgo_critico" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- =============== CASILLAS DE VERIFICACION =============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/rep_opciones"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_s">

                    <CheckBox
                        android:id="@+id/checkUrgente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/rep_check_urgente" />

                    <CheckBox
                        android:id="@+id/checkAnonimo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/height_button"
                        android:text="@string/rep_check_anonimo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- =============== Ubicacion simulada =============== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:text="@string/rep_ubicacion"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <TextView
                android:id="@+id/txtUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="@dimen/space_s"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Aqualert.Body"
                app:drawableStartCompat="@drawable/ic_ubicacion"
                tools:text="Bogota, sector simulado  (4.71100, -74.07210)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimularUbicacion"
                style="@style/Widget.Aqualert.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rep_simular_ubicacion" />

            <!-- =============== Acciones =============== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                style="@style/Widget.Aqualert.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/rep_enviar"
                app:icon="@drawable/ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminar"
                style="@style/Widget.Aqualert.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/rep_eliminar"
                android:textColor="@color/state_danger"
                android:visibility="gone"
                app:icon="@drawable/ic_eliminar"
                app:iconTint="@color/state_danger"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>