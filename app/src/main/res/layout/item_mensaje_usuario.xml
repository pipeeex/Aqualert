<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingTop="@dimen/space_xs"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_burbuja_usuario"
        android:lineSpacingMultiplier="1.2"
        android:padding="@dimen/space_m"
        android:textColor="@color/neutral_white"
        android:textSize="@dimen/text_body"
        tools:text="Como creo un reporte?" />

    <TextView
        android:id="@+id/txtHora"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.Aqualert.Caption"
        tools:text="14:32" />

</LinearLayout>