<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Encabezado con el perfil ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_encabezado_inicio"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_xl"
                android:paddingTop="@dimen/space_xxl"
                android:paddingEnd="@dimen/space_xl"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_logo_aqualert" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="0.05"
                        android:text="@string/app_name"
                        android:textColor="@color/neutral_white"
                        android:textSize="@dimen/text_subtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCerrarSesion"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/auth_cerrar_sesion"
                        app:icon="@drawable/ic_salir"
                        app:iconSize="20dp"
                        app:iconTint="@color/neutral_white" />
                </LinearLayout>

                <!-- Avatar y saludo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtIniciales"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_avatar_claro"
                        android:gravity="center"
                        android:textColor="@color/fluent_accent_darker"
                        android:textSize="@dimen/text_subtitle"
                        android:fontFamily="sans-serif-medium"
                        tools:text="AM" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtSaludo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/neutral_white"
                            android:textSize="@dimen/text_title"
                            android:fontFamily="sans-serif-medium"
                            tools:text="Hola, Alejandro" />

                        <TextView
                            android:id="@+id/txtDetalle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.85"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/neutral_white"
                            android:textSize="@dimen/text_body"
                            tools:text="alejandro@correo.com" />

                        <TextView
                            android:id="@+id/txtRol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:background="@drawable/bg_chip_translucido"
                            android:paddingStart="@dimen/space_s"
                            android:paddingTop="2dp"
                            android:paddingEnd="@dimen/space_s"
                            android:paddingBottom="2dp"
                            android:textColor="@color/neutral_white"
                            android:textSize="@dimen/text_caption"
                            tools:text="Ciudadano" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Aporte del usuario ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAporte"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="@dimen/space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:id="@+id/txtTotalReportes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/fluent_accent"
                        android:textSize="@dimen/text_display"
                        tools:text="3" />

                    <TextView
                        android:id="@+id/txtEtiquetaReportes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Aqualert.Body"
                        tools:text="reportes aportados a la comunidad" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Aviso para el visitante ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisoVisitante"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="@dimen/space_l"
                android:visibility="gone"
                app:cardBackgroundColor="@color/state_info_bg"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ini_aviso_visitante"
                        android:textAppearance="@style/TextAppearance.Aqualert.Body" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarSesion"
                        style="@style/Widget.Aqualert.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:text="@string/auth_iniciar_sesion" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Accesos ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/ini_que_hacer"
                android:textAppearance="@style/TextAppearance.Aqualert.Subtitle" />

            <!-- UC3: Consultar reportes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoReportes"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_m"
                android:layout_marginEnd="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_acceso"
                        android:contentDescription="@string/nav_reportes"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_reportes"
                        app:tint="@color/fluent_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_reportes"
                            android:textColor="@color/neutral_grey130"
                            android:textSize="@dimen/text_body_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_reportes_desc"
                            android:textAppearance="@style/TextAppearance.Aqualert.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flecha_derecha"
                        app:tint="@color/neutral_grey30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UC5: Crear reporte -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoCrear"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_acceso"
                        android:contentDescription="@string/nav_crear"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_agregar"
                        app:tint="@color/fluent_teal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_crear"
                            android:textColor="@color/neutral_grey130"
                            android:textSize="@dimen/text_body_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_crear_desc"
                            android:textAppearance="@style/TextAppearance.Aqualert.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flecha_derecha"
                        app:tint="@color/neutral_grey30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UC9: Consultar consejos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoConsejos"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_l"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_acceso"
                        android:contentDescription="@string/nav_consejos"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_consejos"
                        app:tint="@color/estado_en_atencion" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_consejos"
                            android:textColor="@color/neutral_grey130"
                            android:textSize="@dimen/text_body_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_consejos_desc"
                            android:textAppearance="@style/TextAppearance.Aqualert.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flecha_derecha"
                        app:tint="@color/neutral_grey30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- UC10: Usar chatbot -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoChatbot"
                style="@style/Widget.Aqualert.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_l"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginEnd="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_xl"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_l">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icono_acceso"
                        android:contentDescription="@string/nav_chatbot"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/estado_en_revision" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_chatbot"
                            android:textColor="@color/neutral_grey130"
                            android:textSize="@dimen/text_body_large"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ini_acceso_chatbot_desc"
                            android:textAppearance="@style/TextAppearance.Aqualert.Caption" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flecha_derecha"
                        app:tint="@color/neutral_grey30" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>