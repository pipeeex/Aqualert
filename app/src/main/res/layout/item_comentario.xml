<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingEnd="@dimen/space_s"
    android:paddingBottom="@dimen/space_m">

    <!-- Avatar con iniciales -->
    <TextView
        android:id="@+id/txtIniciales"
        android:layout_width="@dimen/size_avatar"
        android:layout_height="@dimen/size_avatar"
        android:background="@drawable/bg_logo_circulo"
        android:gravity="center"
        android:textColor="@color/neutral_white"
        android:textSize="@dimen/text_body"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="FV" />

    <TextView
        android:id="@+id/txtNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/neutral_grey130"
        android:textSize="@dimen/text_body"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintEnd_toStartOf="@id/txtFecha"
        app:layout_constraintStart_toEndOf="@id/txtIniciales"
        app:layout_constraintTop_toTopOf="@id/txtIniciales"
        tools:text="Felipe Villaquiran" />

    <TextView
        android:id="@+id/txtFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Aqualert.Caption"
        app:layout_constraintBottom_toBottomOf="@id/txtNombre"
        app:layout_constraintEnd_toStartOf="@id/btnAcciones"
        app:layout_constraintTop_toTopOf="@id/txtNombre"
        tools:text="hace 5 min" />

    <!-- Menu de moderacion: visible solo para el autor o el administrador -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcciones"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/com_acciones"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:visibility="gone"
        app:icon="@drawable/ic_mas_opciones"
        app:iconSize="18dp"
        app:iconTint="@color/neutral_grey60"
        app:layout_constraintBottom_toBottomOf="@id/txtNombre"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtNombre"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txtContenido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_s"
        android:textAppearance="@style/TextAppearance.Aqualert.Body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtIniciales"
        app:layout_constraintTop_toBottomOf="@id/txtNombre"
        tools:text="Yo paso por ahi todos los dias. El problema empeora los fines de semana cuando no pasa el carro recolector." />

</androidx.constraintlayout.widget.ConstraintLayout>